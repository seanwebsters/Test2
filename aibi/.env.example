# All keys are optional. Without them AIBI runs in a clearly labelled demo mode.
# They are only ever read on the server (src/app/api/*), never sent to the browser.

# Enables live Claude responses in lessons, coaching and the Playground.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
AIBI_MODEL=

# Enables real image generation in the Playground and creative lessons.
OPENAI_API_KEY=
