# ---------------------------------------------------------------------------
# Calm Stories configuration. Every integration is optional: without keys the
# app runs on local, clearly labelled simulated adapters.
# ---------------------------------------------------------------------------

APP_ENV=development                 # development | production | test
SESSION_SECRET=change-me-to-a-long-random-string

# Data: "local" JSON store (dev/demo) or "supabase" PostgreSQL
DATA_BACKEND=local
DATA_DIR=.data                      # on Vercel with local backend use /tmp/.data (ephemeral)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to the browser

# Identity: "demo" persona switcher, or "supabase" Auth (sb-access-token cookie)
AUTH_PROVIDER=demo

# Writing models (provider-independent AI layer)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice
ELEVENLABS_API_KEY=

# Storage for produced audio/artwork: local | r2 | supabase
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
SUPABASE_STORAGE_BUCKET=calm-stories

FFMPEG_PATH=                        # defaults to "ffmpeg" on PATH; pure-TS fallback otherwise

# Analytics
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Background jobs: "inline" (in-process worker) or "trigger" (Trigger.dev)
JOB_DRIVER=inline
TRIGGER_SECRET_KEY=
CRON_SECRET=                        # protects /api/cron/* when called by Vercel Cron
