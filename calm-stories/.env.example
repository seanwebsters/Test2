# --- Core ---------------------------------------------------------------
APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# local (JSON store in .data/) | supabase
DATA_BACKEND=local
DATA_DIR=.data
# demo (persona switcher) | supabase
AUTH_PROVIDER=demo

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=calm-stories

# --- Calm subscription entitlements (optional; mock entitlements otherwise) --
CALM_ENTITLEMENTS_URL=
CALM_ENTITLEMENTS_API_KEY=

# --- Production agents (server-side only; never exposed to the browser) ---
# Without a key, that agent uses a clearly labelled offline stand-in.
# Showrunner / Writer / Sleep Editor
ANTHROPIC_API_KEY=
# Narrator (text-to-speech) and Sound Designer (sound effects)
ELEVENLABS_API_KEY=
# Art Director – "Nano Banana" (Gemini image generation)
GEMINI_API_KEY=

# --- Storage: local | r2 | supabase ---------------------------------------
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
FFMPEG_PATH=

# --- Analytics ------------------------------------------------------------
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Heartbeat (Vercel Cron → /api/cron/tick): agent schedule + releases ---
CRON_SECRET=
