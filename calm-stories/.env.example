# --- Core ---------------------------------------------------------------
APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# local (JSON store in .data/) | supabase
DATA_BACKEND=local
DATA_DIR=.data
# demo (persona switcher) | supabase
AUTH_PROVIDER=demo

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=calm-stories

# --- Calm subscription entitlements (optional; mock entitlements otherwise) --
CALM_ENTITLEMENTS_URL=
CALM_ENTITLEMENTS_API_KEY=

# --- Sleep Stories Studio providers (server-side only; never sent to the browser) ---
# Without a key, the agents that need it stop and ask for it (no fake output).
# Writing, editorial, critique and image-review agents (Claude)
ANTHROPIC_API_KEY=
# Art Director – "Nano Banana" (Gemini image generation). GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# …or use Nano Banana through fal.ai instead of Google
FAL_KEY=
# Voices, narration, pronunciation dictionaries, sound effects and music
ELEVENLABS_API_KEY=

# --- Storage: local | r2 | supabase ---------------------------------------
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Required on the worker for mixing and mastering (or ffmpeg on PATH)
FFMPEG_PATH=

# --- Analytics ------------------------------------------------------------
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Heartbeat (Vercel Cron → /api/cron/tick): agent schedule + releases ---
CRON_SECRET=
