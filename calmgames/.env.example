# ── AI ────────────────────────────────────────────────────────────────
# Required for generation. Read only on the server; never sent to the browser.
ANTHROPIC_API_KEY=
# Optional: default model for every agent (each agent can be changed in Settings).
# CALM_DEFAULT_MODEL=claude-opus-5-5

# ── Storage ───────────────────────────────────────────────────────────
# "local" (default) keeps everything in JSON files under DATA_DIR.
# "supabase" uses the tables in supabase/migrations.
DATA_BACKEND=local
DATA_DIR=.data

# Only needed when DATA_BACKEND=supabase. The service-role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Limits ────────────────────────────────────────────────────────────
# Generation requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=6
# Hard stop for one generation job, in US dollars (estimated from token usage).
JOB_COST_CAP_USD=3
