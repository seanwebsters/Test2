# Where the local JSON store lives (default ./.data). Mount a volume here in production.
DATA_DIR=.data
# Signs session cookies. REQUIRED in production.
SESSION_SECRET=change-me
# Password for the seeded "studio" admin account (default in development: nexara-studio)
STUDIO_ADMIN_PASSWORD=
# Optional: enables the real AI agents in NEXARA Studio. Without it Studio uses the
# offline template generator and labels every draft as such.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: Supabase (see docs/SUPABASE.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
