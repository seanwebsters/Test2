# KNOWHOW runs fully without any of these (demo mode). Copy to .env.local and fill in what you have.

# ── Sessions (required in production) — any long random string
SESSION_SECRET=

# ── AI personal series ("Make me smarter about…")
# Without a key, the feature runs in clearly labelled demo mode with five pre-written sample series.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Text-to-speech for AI series (optional). Without one, AI episodes play with the
# browser's built-in voice, labelled as a development fallback.
# TTS_PROVIDER=elevenlabs   # or openai; default: whichever key is set
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# ── Supabase: accounts (email OTP), database and storage. Without it, a JSON store in DATA_DIR is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (optional). Without it, purchases use a clearly labelled SIMULATED checkout
# that never collects card details or charges money. Set ALLOW_SIMULATED_PAYMENTS=0 to disable that.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ALLOW_SIMULATED_PAYMENTS=0

# ── Demo JSON store location (default ./.data; /tmp on Vercel)
# DATA_DIR=
