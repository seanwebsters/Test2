# ─────────────────────────────────────────────────────────────
# DIRECTION environment variables
# Everything is optional for local development: with nothing set,
# the app runs on a local JSON store, local accounts, the offline
# coach and mock checkout.
# ─────────────────────────────────────────────────────────────

# Public URL of the app (used for Stripe redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs local session cookies. REQUIRED in production when not using Supabase.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Local store location (local mode only).
DATA_DIR=.data

# Set to "off" to hide the "Try the demo" account.
DEMO_MODE=on

# ── Supabase (auth, Postgres with RLS) ──
# When both public values are set, Supabase replaces local accounts and storage.
# Run supabase/migrations/*.sql first. For the demo button, enable
# Authentication → Providers → Anonymous sign-ins.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for subscriptions (checkout/webhooks) and full account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI coach (server-side only; never exposed to the browser) ──
# Without a key the coach runs in clearly labelled offline mode.
ANTHROPIC_API_KEY=
# Optional model override.
AI_MODEL=claude-opus-5-5

# ── Stripe (live billing). Without these, checkout is a clearly labelled mock. ──
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Live job listings (optional, UK) ──
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
